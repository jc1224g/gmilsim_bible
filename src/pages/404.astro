---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없어요" noindex>
  <div class="wrap">
    <div class="empty" style="margin-top:2.5rem">
      <p class="big" aria-hidden="true">404</p>
      <h3>이 페이지는 없어요</h3>
      <p>주소가 바뀌었거나 아직 공개되지 않은 글일 수 있어요.</p>
      <p style="margin-top:1.25rem"><a class="btn" href="/">전체 강의 목록으로</a></p>
    </div>
  </div>
</Base>
