---
// 교회 홈페이지(Google Sites) 설교란에 삽입하는 작은 목록 화면. 주소: /embed/
// Sites 삽입 상자는 높이가 고정이라, 여기서는 강 목록만 보여 주고 글은 새 탭에서 전체 화면으로 열어요.
// Sites 페이지가 밝은 화면이라 어두운 모드 없이 밝게만 보여 줘요.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import { SITE } from '../../site.config.mjs';
import { getAllEditions, getPosts, postUrl, partLabel, editionLabel, formatDate, withBase, type Post } from '../lib/posts';

const all = (await getAllEditions()).filter((p) => !p.data.test);
const lessons = (await getPosts()).filter((p) => !p.data.test).sort((a, b) => b.data.no - a.data.no);
const editionsOf = (lesson: Post) => all.filter((p) => p.data.no === lesson.data.no);
const isPrimary = (lesson: Post, p: Post) => p.data.edition === lesson.data.edition;
const home = new URL(withBase('/'), Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.name} — 목록</title>
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light" />
    <base target="_blank" />
    <style>
      :root {
        --navy: #16233a;
        --text-sub: #4a5568;
        --line: #e2d8c3;
        --accent: #8a5a0b;
        --link: #1f4f8a;
        --chip: #f3ecdd;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; background: #ffffff; color: var(--navy); }
      body {
        font-family: 'Pretendard Variable', Pretendard, -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', sans-serif;
        font-size: 16px;
        line-height: 1.55;
        padding: 4px 4px 12px;
      }
      .head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 10px; }
      .head h1 { font-size: 1.15rem; margin: 0; }
      .head p { margin: 0; color: var(--text-sub); font-size: 0.9rem; }
      a { color: var(--link); }
      ol { list-style: none; margin: 0; padding: 0; }
      li.lesson { border-top: 1px solid var(--line); padding: 14px 0; }
      .meta { color: var(--accent); font-size: 0.85rem; font-weight: 600; }
      .title { display: block; font-size: 1.1rem; font-weight: 700; color: var(--navy); text-decoration: none; margin: 2px 0 4px; }
      .title:hover, .title:focus-visible { text-decoration: underline; }
      .summary { margin: 0 0 8px; color: var(--text-sub); font-size: 0.95rem; }
      .eds { display: flex; flex-wrap: wrap; gap: 6px; }
      .eds a {
        display: inline-block; padding: 4px 10px; border-radius: 999px; background: var(--chip);
        color: var(--navy); text-decoration: none; font-size: 0.85rem;
      }
      .eds a:hover, .eds a:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
      .empty { border-top: 1px solid var(--line); padding: 16px 0; color: var(--text-sub); }
      .all { display: inline-block; margin-top: 8px; font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <div class="head">
      <h1>{SITE.name}</h1>
      <p>{SITE.series} · 누르면 새 탭에서 열려요</p>
    </div>

    {lessons.length ? (
      <ol>
        {lessons.map((lesson) => (
          <li class="lesson">
            <span class="meta">제{lesson.data.no}강 · {formatDate(lesson.data.date)}</span>
            <a class="title" href={postUrl(lesson)}>{lesson.data.title}</a>
            <p class="summary">{lesson.data.summary}</p>
            <div class="eds" aria-label="판 고르기">
              {editionsOf(lesson).map((p) => (
                <a href={postUrl(p, isPrimary(lesson, p))}>
                  {editionLabel(p.data.edition)}{p.data.part ? ` ${partLabel(p)}` : ''}
                </a>
              ))}
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty">첫 강을 준비하고 있어요.</p>
    )}

    <a class="all" href={home}>블로그에서 전체 보기 ↗</a>
  </body>
</html>
